import requests
from bs4 import BeautifulSoup
import pandas as pd

# Convert rating text ("Three", "Five") to a numeric value
rating_map = {
    "One": 1,
    "Two": 2,
    "Three": 3,
    "Four": 4,
    "Five": 5
}

def scrape_books(min_rating=4, max_price=20):
    base_url = "https://books.toscrape.com/"
    page_url = base_url + "catalogue/page-1.html"

    books_data = []

    while True:
        response = requests.get(page_url)
        soup = BeautifulSoup(response.text, "html.parser")

        # Select all book elements
        books = soup.select(".product_pod")

        for book in books:
            # Title
            title = book.h3.a["title"]

            # Rating text to int
            rating_class = book.p["class"][1]
            rating = rating_map.get(rating_class, 0)

            # Price
            price = float(book.select_one(".price_color").text[1:])  # £51.77 → 51.77

            # Skip books not matching filters
            if rating < min_rating or price > max_price:
                continue

            # Link to book details
            book_relative_url = book.h3.a["href"].replace("../../../", "")
            book_url = base_url + "catalogue/" + book_relative_url

            # Scrape book detail page
            details_page = requests.get(book_url)
            details_soup = BeautifulSoup(details_page.text, "html.parser")

            # Table with UPC and availability
            table = details_soup.select("table tr")
            details_dict = {row.th.text: row.td.text for row in table}

            upc = details_dict.get("UPC")
            availability = details_dict.get("Availability")

            # Description
            desc_elem = details_soup.select_one("#product_description ~ p")
            description = desc_elem.text.strip() if desc_elem else "No description"

            # Genre (breadcrumb navigation)
            genre = details_soup.select(".breadcrumb li a")[-1].text

            books_data.append({
                "UPC": upc,
                "Title": title,
                "Price (£)": price,
                "Rating": rating,
                "Genre": genre,
                "Availability": availability,
                "Description": description
            })

        # Pagination: look for next page
        next_button = soup.select_one(".next a")
        if next_button:
            next_page = next_button["href"]
            page_url = base_url + "catalogue/" + next_page
        else:
            break

    # Convert to DataFrame
    return pd.DataFrame(books_data)

df = scrape_books(min_rating=4, max_price=20)
df.head()
