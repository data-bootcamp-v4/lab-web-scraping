    "# Función para scrapear la página individual\n",
    "def page_scrap(link, product):\n",
    "    \n",
    "    base_url = \"https://books.toscrape.com/\"\n",
    "    \n",
    "    if not link.startswith(\"catalogue/\"):\n",
    "        link = \"catalogue/\" + link\n",
    "    \n",
    "    url = urljoin(base_url, link)\n",
    "    \n",
    "    response = requests.get(url)\n",
    "\n",
    "    if response.status_code == 200:\n",
    "        page = BeautifulSoup(response.content, \"html.parser\")\n",
    "\n",
    "        upc = page.find(\"th\", string=\"UPC\").find_next(\"td\").text.strip()\n",
    "        \n",
    "        genre = page.find(\"ul\", class_=\"breadcrumb\").find_all(\"li\")[2].text.strip()\n",
    "        \n",
    "        description = page.find(\n",
    "            \"div\", id=\"product_description\"\n",
    "        ).find_next_sibling(\"p\").text.strip()\n",
    "\n",
    "        product[\"UPC\"] = upc\n",
    "        product[\"Genre\"] = genre\n",
    "        product[\"Description\"] = description\n",
    "\n",
    "    else:\n",
    "        print(f\"Page not found: {url}\")\n"
   ]
