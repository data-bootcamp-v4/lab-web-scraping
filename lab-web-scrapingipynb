    "# Recorrer todas las páginas\n",
    "while True:\n",
    "\n",
    "    url = f\"https://books.toscrape.com/catalogue/page-{page_number}.html\"\n",
    "\n",
    "    response = requests.get(url)\n",
    "\n",
    "    # Si la página no existe, terminamos\n",
    "    if response.status_code == 404:\n",
    "        print(\"No more pages.\")\n",
    "        break\n",
    "\n",
    "    # Crear Soup\n",
    "    page = BeautifulSoup(response.content, \"html.parser\")\n",
    "\n",
    "    # Obtener todos los libros de la página\n",
    "    books = page.find_all(\n",
    "        \"article\",\n",
    "        class_=\"product_pod\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # Recorrer los libros\n",
    "    for book_info in books:\n",
    "\n",
    "        # Rating\n",
    "        star = book_info.find(\n",
    "            \"p\",\n",
    "            class_=\"star-rating\"\n",
    "        )[\"class\"][1]\n",
    "\n",
    "        star = rating_dict[star]\n",
    "\n",
    "\n",
    "        # Price\n",
    "        price = book_info.find(\n",
    "            \"p\",\n",
    "            class_=\"price_color\"\n",
    "        ).text.strip()\n",
    "\n",
    "        price = float(price.replace(\"£\", \"\"))\n",
    "\n",
    "\n",
    "        # Stock\n",
    "        stock = book_info.find(\n",
    "            \"p\",\n",
    "            class_=\"instock availability\"\n",
    "        ).text.strip()\n",
    "\n",
    "        stock = stock == \"In stock\"\n",
    "\n",
    "\n",
    "        # Title\n",
    "        title = book_info.find(\n",
    "            \"h3\"\n",
    "        ).find(\"a\")[\"title\"]\n",
    "\n",
    "\n",
    "        # Link\n",
    "        link = book_info.find(\n",
    "            \"h3\"\n",
    "        ).find(\"a\")[\"href\"]\n",
    "\n",
    "\n",
    "        # Filtrar productos\n",
    "        if star >= 4 and price <= 20 and stock:\n",
    "\n",
    "            # Crear producto\n",
    "            product = {\n",
    "                \"Rating\": star,\n",
    "                \"Price\": price,\n",
    "                \"Stock\": stock,\n",
    "                \"Title\": title\n",
    "            }\n",
    "\n",
    "            # Entrar en la página individual\n",
    "            page_scrap(link, product)\n",
    "\n",
    "            # Guardar producto completo\n",
    "            products.append(product)\n",
    "\n",
    "            # Esperar entre requests\n",
    "            time.sleep(1)\n",
    "\n",
    "\n",
    "    print(f\"Page {page_number} scraped.\")\n",
    "\n",
    "    # Pasar a la siguiente página\n",
    "    page_number += 1\n",
    "\n",
    "\n",
    "# Crear DataFrame\n",
    "df = pd.DataFrame(products)\n",
    "\n",
    "print(df)"
